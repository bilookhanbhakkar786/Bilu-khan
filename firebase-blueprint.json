        "activeSchoolId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Submitted via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Submitted via FieldValue.serverTimestamp()." }
      },
      "required": ["userId", "fullName", "email", "phone", "accountIntent", "createdAt", "updatedAt"]
    },
