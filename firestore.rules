                         incoming().schoolId == schoolId &&
                         incoming().keys().hasAll(['schoolId', 'schoolOwnerId', 'sessionId', 'classId', 'sectionId', 'title', 'description', 'amountText', 'feeDate', 'paidStudentIds', 'createdByName', 'updatedByName', 'staffUids', 'memberUids', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['schoolId', 'schoolOwnerId', 'sessionId', 'classId', 'sectionId', 'title', 'description', 'amountText', 'feeDate', 'paidStudentIds', 'paidDetails', 'createdBy', 'createdByName', 'updatedByName', 'staffUids', 'memberUids', 'createdAt', 'updatedAt']) &&
                         isTimestampsCreate(incoming()) &&
                         isValidClassFee(incoming()) &&
                         isSchoolStaff(schoolId);

        allow update: if isSignedIn() &&
                         isValidId(feeId) &&
                         isValidClassFee(incoming()) &&
                         incoming().schoolId == existing().schoolId &&
                         incoming().sessionId == existing().sessionId &&
                         incoming().classId == existing().classId &&
                         incoming().sectionId == existing().sectionId &&
                         isTimestampsUpdate() &&
                         isSchoolStaff(schoolId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'amountText', 'feeDate', 'paidStudentIds', 'paidDetails', 'updatedByName', 'schoolOwnerId', 'staffUids', 'memberUids', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(feeId) && isSchoolStaff(schoolId);
      }

      // Notifications
      match /notifications/{notificationId} {
        allow get: if isSuperAdmin() || (isSignedIn() && isValidId(notificationId) && (existing().userId == request.auth.uid || isSchoolPrincipal(schoolId)));
        allow list: if isSuperAdmin() || (isSignedIn() && (isSchoolPrincipal(schoolId) || resource.data.userId == request.auth.uid || resource.data.schoolOwnerId == request.auth.uid));

        allow create: if isSignedIn() &&
                         isValidId(notificationId) &&
                         incoming().schoolId == schoolId &&
                         incoming().keys().hasAll(['schoolId', 'schoolOwnerId', 'userId', 'title', 'message', 'category', 'isRead', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['schoolId', 'schoolOwnerId', 'userId', 'title', 'message', 'category', 'isRead', 'referenceId', 'createdAt', 'updatedAt']) &&
                         isTimestampsCreate(incoming()) &&
                         isValidNotification(incoming()) &&
                         isSchoolStaff(schoolId);

        allow update: if isSignedIn() &&
                         isValidId(notificationId) &&
                         isValidNotification(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().schoolId == existing().schoolId &&
                         isTimestampsUpdate() && (
                           (existing().userId == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt'])) ||
                           (isSchoolPrincipal(schoolId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['schoolOwnerId', 'updatedAt']))
                         );

        allow delete: if isSignedIn() && isValidId(notificationId) && (existing().userId == request.auth.uid || isSchoolPrincipal(schoolId));
      }
    }
  }
}
