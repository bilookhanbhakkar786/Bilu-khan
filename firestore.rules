rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             request.auth.token.email_verified == true &&
             request.auth.token.email.lower() == 'bilookhanbhakkar@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptStr(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    function isUidList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 128));
    }

    function isOptUidList(data, key, maxLen) {
      return !(key in data) || isUidList(data[key], maxLen);
    }

    function isOptStrList(data, key, maxLen, maxItemLen) {
      return !(key in data) || (
        data[key] is list &&
        data[key].size() <= maxLen &&
        (data[key].size() == 0 || (data[key][0] is string && data[key][0].size() <= maxItemLen))
      );
    }

    function isTimestampsCreate(data) {
      return data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isTimestampsUpdate() {
      return incoming().createdAt == existing().createdAt &&
             incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
    }

    function schoolDoc(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId));
    }

    function memberDoc(schoolId, uid) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/members/$(uid));
    }

    function isSchoolPrincipal(schoolId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/schools/$(schoolId)) &&
             schoolDoc(schoolId).data.ownerId == request.auth.uid;
    }

    function isSchoolVisibleToStudent(schoolId) {
      return exists(/databases/$(database)/documents/schools/$(schoolId)) &&
             (!('isPublic' in schoolDoc(schoolId).data) || schoolDoc(schoolId).data.isPublic == true);
    }

    function isSchoolMember(schoolId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)) &&
             memberDoc(schoolId, request.auth.uid).data.status == 'active' &&
             (memberDoc(schoolId, request.auth.uid).data.role in ['principal', 'teacher'] ||
              isSchoolVisibleToStudent(schoolId));
    }

    function isSchoolTeacher(schoolId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)) &&
             memberDoc(schoolId, request.auth.uid).data.role == 'teacher' &&
             memberDoc(schoolId, request.auth.uid).data.status == 'active';
    }

    function isSchoolStaff(schoolId) {
      return isSchoolPrincipal(schoolId) || isSchoolTeacher(schoolId);
    }

    function isValidPermissionsMap(p) {
      return p is map &&
             p.keys().hasAll([
               'viewStudents', 'editStudents', 'markAttendance', 'editAttendance',
               'createTests', 'enterMarks', 'publishAnnouncements', 'viewReports'
             ]) &&
             p.keys().hasOnly([
               'viewStudents', 'editStudents', 'markAttendance', 'editAttendance',
               'createTests', 'enterMarks', 'publishAnnouncements', 'viewReports'
             ]) &&
             p.viewStudents is bool && p.editStudents is bool &&
             p.markAttendance is bool && p.editAttendance is bool &&
             p.createTests is bool && p.enterMarks is bool &&
             p.publishAnnouncements is bool && p.viewReports is bool;
    }

    function isStudentAccountLocked(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
             get(/databases/$(database)/documents/users/$(uid)).data.accountIntent == 'student';
    }

    function isPinnedSchoolList(data) {
      return !('pinnedSchoolIds' in data) || (
        data.pinnedSchoolIds is list &&
        data.pinnedSchoolIds.size() <= 3 &&
        (data.pinnedSchoolIds.size() < 1 || (data.pinnedSchoolIds[0] is string && data.pinnedSchoolIds[0].size() >= 1 && data.pinnedSchoolIds[0].size() <= 128)) &&
        (data.pinnedSchoolIds.size() < 2 || (data.pinnedSchoolIds[1] is string && data.pinnedSchoolIds[1].size() >= 1 && data.pinnedSchoolIds[1].size() <= 128)) &&
        (data.pinnedSchoolIds.size() < 3 || (data.pinnedSchoolIds[2] is string && data.pinnedSchoolIds[2].size() >= 1 && data.pinnedSchoolIds[2].size() <= 128))
      );
    }

    // --- ENTITY VALIDATION HELPERS ---
    function isValidUserProfile(data) {
      return isStr(data.userId, 1, 128) &&
             isStr(data.fullName, 1, 120) &&
             isStr(data.email, 0, 160) &&
             isStr(data.phone, 0, 40) &&
             isOptStr(data, 'avatarUrl', 400000) &&
             data.accountIntent in ['principal', 'teacher', 'student'] &&
             isOptStr(data, 'activeSchoolId', 128) &&
             isPinnedSchoolList(data);
    }

    function isValidPrincipalLock(data) {
      return isStr(data.userId, 1, 128) &&
             isStr(data.schoolId, 1, 128) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidSchoolDirectory(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolCode, 3, 40) &&
             isStr(data.ownerId, 1, 128) &&
             isStr(data.name, 2, 160) &&
             data.schoolType in ['Private', 'Government', 'Other'] &&
             isStr(data.city, 1, 100) &&
             data.isPublic is bool;
    }

    function isValidSchool(data) {
      return isStr(data.schoolCode, 3, 40) &&
             isStr(data.ownerId, 1, 128) &&
             isStr(data.name, 2, 160) &&
             data.schoolType in ['Private', 'Government', 'Other'] &&
             isStr(data.address, 0, 300) &&
             isStr(data.city, 1, 100) &&
             isStr(data.contactNumber, 1, 40) &&
             isStr(data.email, 1, 160) &&
             isStr(data.description, 0, 2000) &&
             (!('establishedYear' in data) || data.establishedYear == null || (data.establishedYear is int && data.establishedYear >= 1800 && data.establishedYear <= 2100)) &&
             isOptStr(data, 'website', 300) &&
             isOptStr(data, 'logoUrl', 400000) &&
             isOptStr(data, 'bannerUrl', 400000) &&
             data.galleryUrls is list && data.galleryUrls.size() <= 8 &&
             (data.galleryUrls.size() == 0 || (data.galleryUrls[0] is string && data.galleryUrls[0].size() <= 300000)) &&
             isStr(data.timezone, 1, 64) &&
             isUidList(data.memberUids, 500) &&
             isUidList(data.staffUids, 100) &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             isOptStr(data, 'lastAcceptedPrincipalInviteCode', 64) &&
             (!('sessionIds' in data) || isUidList(data.sessionIds, 100)) &&
             (!('classIds' in data) || isUidList(data.classIds, 200)) &&
             (!('sectionIds' in data) || isUidList(data.sectionIds, 300));
    }

    function isValidPrincipalInvitation(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolName, 1, 160) &&
             isStr(data.schoolCode, 3, 40) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.email, 3, 160) &&
             isStr(data.emailLower, 3, 160) &&
             isStr(data.fullName, 1, 120) &&
             isStr(data.inviteCode, 4, 40) &&
             data.status in ['pending', 'accepted', 'revoked'] &&
             isStr(data.invitedBy, 1, 128) &&
             isOptStr(data, 'acceptedByUid', 128);
    }

    function isValidMember(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.userId, 1, 128) &&
             data.role in ['principal', 'teacher', 'student'] &&
             data.status in ['active', 'suspended'] &&
             isOptStr(data, 'inviteCode', 64) &&
             isOptStr(data, 'linkedStudentId', 128);
    }

    function isValidTeacherInvitation(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolName, 1, 160) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.email, 0, 160) &&
             isStr(data.emailLower, 0, 160) &&
             isStr(data.fullName, 1, 120) &&
             isStr(data.phone, 0, 40) &&
             isStr(data.inviteCode, 4, 40) &&
             isValidPermissionsMap(data.permissions) &&
             data.status in ['pending', 'accepted', 'revoked'] &&
             isStr(data.invitedBy, 1, 128) &&
             isOptStr(data, 'acceptedByUid', 128) &&
             isOptStr(data, 'authType', 40) &&
             isOptStr(data, 'username', 80) &&
             isOptStr(data, 'usernameLower', 80) &&
             isOptStr(data, 'accessPassword', 100);
    }

    function isValidTeacherCredential(data) {
      return isStr(data.username, 3, 40) &&
             isStr(data.usernameLower, 3, 40) &&
             isStr(data.accessPassword, 4, 100) &&
             isStr(data.inviteCode, 4, 40) &&
             isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolName, 1, 160) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             data.status in ['pending', 'accepted', 'revoked'] &&
             isStr(data.invitedBy, 1, 128) &&
             isOptStr(data, 'acceptedByUid', 128);
    }

    function isValidTeacherRequest(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.schoolName, 1, 160) &&
             isStr(data.userId, 1, 128) &&
             isStr(data.fullName, 1, 120) &&
             isStr(data.email, 0, 160) &&
             isStr(data.phone, 0, 40) &&
             isStr(data.subjectSpecialty, 0, 120) &&
             isStr(data.note, 0, 500) &&
             data.status in ['pending', 'approved', 'rejected'] &&
             isUidList(data.staffUids, 100);
    }

    function isValidTeacherProfile(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.userId, 1, 128) &&
             isStr(data.fullName, 1, 120) &&
             isStr(data.email, 0, 160) &&
             isStr(data.phone, 0, 40) &&
             isOptStr(data, 'avatarUrl', 400000) &&
             isStr(data.joiningDate, 1, 40) &&
             data.isActive is bool &&
             isValidPermissionsMap(data.permissions) &&
             isUidList(data.staffUids, 100) &&
             isOptUidList(data, 'memberUids', 500);
    }

    function isValidTeacherAssignment(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.sessionId, 1, 128) &&
             isStr(data.teacherProfileId, 1, 128) &&
             isStr(data.sectionId, 1, 128) &&
             isStr(data.subject, 1, 100) &&
             isUidList(data.staffUids, 100);
    }

    function isValidAcademicSession(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.name, 2, 60) &&
             isOptStr(data, 'startDate', 40) &&
             isOptStr(data, 'endDate', 40) &&
             data.isCurrent is bool &&
             isUidList(data.staffUids, 100) &&
             isUidList(data.memberUids, 500);
    }

    function isValidSchoolClass(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.sessionId, 1, 128) &&
             isStr(data.name, 1, 80) &&
             isStr(data.description, 0, 500) &&
             isUidList(data.staffUids, 100) &&
             isUidList(data.memberUids, 500);
    }

    function isValidClassSection(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.sessionId, 1, 128) &&
             isStr(data.classId, 1, 128) &&
             isStr(data.name, 1, 40) &&
             isOptStr(data, 'classTeacherId', 128) &&
             isStr(data.description, 0, 500) &&
             isOptStrList(data, 'customLectures', 50, 60) &&
             isUidList(data.staffUids, 100) &&
             isUidList(data.memberUids, 500);
    }

    function isValidStudentRecord(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.sessionId, 1, 128) &&
             isStr(data.classId, 1, 128) &&
             isStr(data.sectionId, 1, 128) &&
             isStr(data.studentCode, 2, 40) &&
             isStr(data.rollNumber, 1, 40) &&
             isStr(data.fullName, 1, 120) &&
             isStr(data.fatherName, 1, 120) &&
             isOptStr(data, 'dateOfBirth', 40) &&
             isStr(data.gender, 1, 20) &&
             isStr(data.parentName, 0, 120) &&
             isStr(data.parentContact, 0, 40) &&
             isStr(data.address, 0, 300) &&
             isStr(data.admissionDate, 0, 40) &&
             isOptStr(data, 'email', 160) &&
             isOptStr(data, 'avatarUrl', 400000) &&
             data.status in ['active', 'promoted', 'graduated', 'inactive'] &&
             isOptStr(data, 'previousRecordId', 128) &&
             isOptStr(data, 'linkedUserId', 128) &&
             isUidList(data.staffUids, 100) &&
             isOptUidList(data, 'memberUids', 500);
    }

    function isValidStudentRequest(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.schoolName, 1, 160) &&
             isStr(data.userId, 1, 128) &&
             isOptStr(data, 'studentId', 128) &&
             isOptStr(data, 'sessionId', 128) &&
             isOptStr(data, 'classId', 128) &&
             isOptStr(data, 'sectionId', 128) &&
             isStr(data.requestedRollNumber, 1, 40) &&
             isStr(data.requestedFullName, 1, 120) &&
             isStr(data.requestedFatherName, 1, 120) &&
             isStr(data.requestedSessionName, 0, 60) &&
             isStr(data.requestedClassName, 0, 80) &&
             isStr(data.requestedSectionName, 0, 40) &&
             data.status in ['pending', 'approved', 'rejected'] &&
             isUidList(data.staffUids, 100);
    }

    function isValidAttendanceSession(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.sessionId, 1, 128) &&
             isStr(data.classId, 1, 128) &&
             isStr(data.sectionId, 1, 128) &&
             isStr(data.attendanceDate, 4, 40) &&
             isStr(data.subject, 1, 100) &&
             isStr(data.sessionSlot, 1, 60) &&
             isOptStr(data, 'teacherId', 128) &&
             isStr(data.teacherName, 0, 120) &&
             isUidList(data.staffUids, 100) &&
             isUidList(data.memberUids, 500);
    }

    function isValidAttendanceRecord(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.attendanceSessionId, 1, 128) &&
             isStr(data.studentId, 1, 128) &&
             isOptStr(data, 'linkedUserId', 128) &&
             data.status in ['present', 'absent', 'leave'] &&
             isStr(data.note, 0, 300) &&
             isOptStr(data, 'updatedBy', 128) &&
             data.editHistory is list && data.editHistory.size() <= 50 &&
             (data.editHistory.size() == 0 || data.editHistory[0] is map) &&
             isUidList(data.staffUids, 100) &&
             isOptUidList(data, 'memberUids', 500);
    }

    function isValidTestExam(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.sessionId, 1, 128) &&
             isStr(data.classId, 1, 128) &&
             isStr(data.sectionId, 1, 128) &&
             isStr(data.name, 1, 140) &&
             isStr(data.subject, 1, 100) &&
             isStr(data.testDate, 4, 40) &&
             data.totalMarks is number && data.totalMarks > 0 && data.totalMarks <= 10000 &&
             data.passingMarks is number && data.passingMarks >= 0 && data.passingMarks <= data.totalMarks &&
             isStr(data.description, 0, 1000) &&
             data.status in ['draft', 'submitted', 'published'] &&
             isOptStr(data, 'createdBy', 128) &&
             isOptStr(data, 'approvedBy', 128) &&
             isUidList(data.staffUids, 100) &&
             isUidList(data.memberUids, 500);
    }

    function isValidTestResult(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.testId, 1, 128) &&
             isStr(data.studentId, 1, 128) &&
             isOptStr(data, 'linkedUserId', 128) &&
             data.obtainedMarks is number && data.obtainedMarks >= 0 && data.obtainedMarks <= 10000 &&
             data.percentage is number && data.percentage >= 0 && data.percentage <= 100 &&
             isStr(data.grade, 1, 10) &&
             data.passed is bool &&
             (!('rank' in data) || data.rank == null || (data.rank is int && data.rank >= 1)) &&
             isOptStr(data, 'enteredBy', 128) &&
             isUidList(data.staffUids, 100) &&
             isOptUidList(data, 'memberUids', 500);
    }

    function isValidAnnouncementPost(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isOptStr(data, 'sessionId', 128) &&
             isOptStr(data, 'classId', 128) &&
             isOptStr(data, 'sectionId', 128) &&
             data.scope in ['school', 'class'] &&
             isStr(data.category, 1, 60) &&
             isStr(data.title, 1, 200) &&
             isStr(data.body, 1, 4000) &&
             isOptStr(data, 'imageUrl', 400000) &&
             data.allowComments is bool &&
             data.likesCount is int && data.likesCount >= 0 &&
             isStr(data.publisherId, 1, 128) &&
             isStr(data.publisherName, 1, 120) &&
             isUidList(data.staffUids, 100) &&
             isUidList(data.memberUids, 500);
    }

    function isValidAnnouncementComment(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.announcementId, 1, 128) &&
             isStr(data.userId, 1, 128) &&
             isStr(data.authorName, 1, 120) &&
             isStr(data.body, 1, 1000) &&
             isUidList(data.memberUids, 500);
    }

    function isValidAnnouncementLike(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.announcementId, 1, 128) &&
             isStr(data.userId, 1, 128) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidTimetableSlot(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.sessionId, 1, 128) &&
             isStr(data.sectionId, 1, 128) &&
             isStr(data.dayOfWeek, 2, 20) &&
             isStr(data.subject, 1, 100) &&
             isStr(data.startTime, 1, 30) &&
             isStr(data.endTime, 1, 30) &&
             isStr(data.teacherName, 0, 120) &&
             isStr(data.roomNumber, 0, 40) &&
             isUidList(data.staffUids, 100) &&
             isUidList(data.memberUids, 500);
    }

    function isValidHomeworkItem(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.sessionId, 1, 128) &&
             isStr(data.sectionId, 1, 128) &&
             isStr(data.subject, 1, 100) &&
             isStr(data.title, 1, 160) &&
             isStr(data.instructions, 1, 3000) &&
             isStr(data.dueDate, 4, 40) &&
             isOptStr(data, 'attachmentUrl', 400000) &&
             isOptStr(data, 'teacherId', 128) &&
             isStr(data.teacherName, 0, 120) &&
             isUidList(data.staffUids, 100) &&
             isUidList(data.memberUids, 500);
    }

    function isValidClassFee(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.sessionId, 1, 128) &&
             isStr(data.classId, 1, 128) &&
             isStr(data.sectionId, 1, 128) &&
             isStr(data.title, 1, 160) &&
             isStr(data.description, 0, 1000) &&
             isStr(data.amountText, 0, 40) &&
             isStr(data.feeDate, 1, 40) &&
             isOptStrList(data, 'paidStudentIds', 500, 128) &&
             (!('paidDetails' in data) || data.paidDetails is map) &&
             isOptStr(data, 'createdBy', 128) &&
             isStr(data.createdByName, 0, 120) &&
             isStr(data.updatedByName, 0, 120) &&
             isUidList(data.staffUids, 100) &&
             isUidList(data.memberUids, 500);
    }

    function isValidNotification(data) {
      return isStr(data.schoolId, 1, 128) &&
             isStr(data.schoolOwnerId, 1, 128) &&
             isStr(data.userId, 1, 128) &&
             isStr(data.title, 1, 200) &&
             isStr(data.message, 1, 1000) &&
             isStr(data.category, 1, 60) &&
             data.isRead is bool &&
             isOptStr(data, 'referenceId', 128);
    }

    function isValidAppVisit(data) {
      return isStr(data.userId, 1, 128) &&
             isStr(data.userEmail, 0, 160) &&
             isStr(data.userName, 0, 120) &&
             data.roleIntent in ['principal', 'teacher', 'student'] &&
             isOptStr(data, 'activeSchoolId', 128) &&
             isOptStr(data, 'activeSchoolName', 160) &&
             isStr(data.dayKey, 8, 20) &&
             isStr(data.monthKey, 5, 16) &&
             isStr(data.dateSortKey, 8, 20) &&
             data.hourBucket is int && data.hourBucket >= 0 && data.hourBucket <= 23;
    }

    // --- ROOT COLLECTIONS ---

    match /app_visits/{visitId} {
      allow get, list, delete: if isSuperAdmin();
      allow create: if isSignedIn() &&
                       isValidId(visitId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'userEmail', 'userName', 'roleIntent', 'dayKey', 'monthKey', 'dateSortKey', 'hourBucket', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'userEmail', 'userName', 'roleIntent', 'activeSchoolId', 'activeSchoolName', 'dayKey', 'monthKey', 'dateSortKey', 'hourBucket', 'createdAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidAppVisit(incoming());
      allow update: if false;
    }

    match /users/{userId} {
      allow get: if isSuperAdmin() || (isSignedIn() && isValidId(userId) && request.auth.uid == userId);
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'fullName', 'email', 'phone', 'accountIntent', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'fullName', 'email', 'phone', 'avatarUrl', 'accountIntent', 'activeSchoolId', 'pinnedSchoolIds', 'createdAt', 'updatedAt']) &&
                       isTimestampsCreate(incoming()) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       (existing().accountIntent != 'student' || incoming().accountIntent == 'student') &&
                       isTimestampsUpdate() &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'email', 'phone', 'avatarUrl', 'accountIntent', 'activeSchoolId', 'pinnedSchoolIds', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    match /principal_locks/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       !isStudentAccountLocked(request.auth.uid) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'schoolId', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'schoolId', 'createdAt']) &&
                       !exists(/databases/$(database)/documents/principal_locks/$(userId)) &&
                       isValidPrincipalLock(incoming());
      allow update: if false;
      allow delete: if isSignedIn() &&
                       isValidId(userId) && (
                         request.auth.uid == userId ||
                         (exists(/databases/$(database)/documents/schools/$(existing().schoolId)) &&
                          schoolDoc(existing().schoolId).data.ownerId == request.auth.uid)
                       );
    }

    match /school_directory/{schoolCode} {
      allow get: if isSignedIn() && isValidId(schoolCode);
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.isPublic == true);

      allow create: if isSignedIn() &&
                       isValidId(schoolCode) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().schoolCode == schoolCode &&
                       incoming().isPublic == true &&
                       incoming().keys().hasAll(['schoolId', 'schoolCode', 'ownerId', 'name', 'schoolType', 'city', 'isPublic', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['schoolId', 'schoolCode', 'ownerId', 'name', 'schoolType', 'city', 'isPublic', 'createdAt', 'updatedAt']) &&
                       isTimestampsCreate(incoming()) &&
                       isValidSchoolDirectory(incoming()) &&
                       existsAfter(/databases/$(database)/documents/schools/$(incoming().schoolId));

      allow update: if isSignedIn() &&
                       isValidId(schoolCode) &&
                       isValidSchoolDirectory(incoming()) &&
                       incoming().schoolId == existing().schoolId &&
                       incoming().schoolCode == existing().schoolCode &&
                       isTimestampsUpdate() && (
                         (existing().ownerId == request.auth.uid &&
                          incoming().ownerId == existing().ownerId &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'schoolType', 'city', 'isPublic', 'updatedAt'])) ||
                         (isSchoolTeacher(existing().schoolId) &&
                          incoming().ownerId == existing().ownerId &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'schoolType', 'city', 'updatedAt'])) ||
                         (incoming().ownerId == request.auth.uid &&
                          getAfter(/databases/$(database)/documents/schools/$(existing().schoolId)).data.ownerId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['ownerId', 'updatedAt'])) ||
                         (isSuperAdmin() &&
                          incoming().ownerId == existing().ownerId &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['isPublic', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(schoolCode) && (existing().ownerId == request.auth.uid || isSuperAdmin());
    }

    match /principal_invitations/{inviteCode} {
      allow get: if isSignedIn() && isValidId(inviteCode);
      allow list: if isSuperAdmin() || (isSignedIn() && (
        resource.data.schoolOwnerId == request.auth.uid ||
        isSchoolPrincipal(resource.data.schoolId) ||
        (('email' in request.auth.token) && request.auth.token.email_verified == true && resource.data.emailLower == request.auth.token.email.lower())
      ));

      allow create: if isSignedIn() &&
                       isValidId(inviteCode) &&
                       incoming().inviteCode == inviteCode &&
                       incoming().status == 'pending' &&
                       incoming().invitedBy == request.auth.uid &&
                       incoming().schoolOwnerId == request.auth.uid &&
                       incoming().keys().hasAll(['schoolId', 'schoolName', 'schoolCode', 'schoolOwnerId', 'email', 'emailLower', 'fullName', 'inviteCode', 'status', 'invitedBy', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['schoolId', 'schoolName', 'schoolCode', 'schoolOwnerId', 'email', 'emailLower', 'fullName', 'inviteCode', 'status', 'invitedBy', 'acceptedByUid', 'createdAt', 'updatedAt']) &&
                       isTimestampsCreate(incoming()) &&
                       isValidPrincipalInvitation(incoming()) &&
                       isSchoolPrincipal(incoming().schoolId);

      allow update: if isSignedIn() &&
                       isValidId(inviteCode) &&
                       isValidPrincipalInvitation(incoming()) &&
                       incoming().schoolId == existing().schoolId &&
                       incoming().inviteCode == existing().inviteCode &&
                       isTimestampsUpdate() && (
                         (isSchoolPrincipal(existing().schoolId) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'schoolOwnerId', 'updatedAt'])) ||
                         (existing().status == 'pending' &&
                          !isStudentAccountLocked(request.auth.uid) &&
                          incoming().status == 'accepted' &&
                          incoming().schoolOwnerId == existing().schoolOwnerId &&
                          incoming().acceptedByUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedByUid', 'updatedAt']) &&
                          !exists(/databases/$(database)/documents/principal_locks/$(request.auth.uid)) &&
                          existsAfter(/databases/$(database)/documents/principal_locks/$(request.auth.uid)) &&
                          getAfter(/databases/$(database)/documents/schools/$(existing().schoolId)).data.ownerId == request.auth.uid)
                       );

      allow delete: if isSignedIn() && isValidId(inviteCode) && isSchoolPrincipal(existing().schoolId);
    }

    match /teacher_invitations/{inviteCode} {
      allow get: if isSignedIn() && isValidId(inviteCode);
      allow list: if isSuperAdmin() || (isSignedIn() && (
        resource.data.schoolOwnerId == request.auth.uid ||
        isSchoolPrincipal(resource.data.schoolId) ||
        (('email' in request.auth.token) && request.auth.token.email_verified == true && resource.data.emailLower == request.auth.token.email.lower())
      ));

      allow create: if isSignedIn() &&
                       isValidId(inviteCode) &&
                       incoming().inviteCode == inviteCode &&
                       incoming().status == 'pending' &&
                       incoming().invitedBy == request.auth.uid &&
                       incoming().schoolOwnerId == request.auth.uid &&
                       incoming().keys().hasAll(['schoolId', 'schoolName', 'schoolOwnerId', 'email', 'emailLower', 'fullName', 'phone', 'inviteCode', 'permissions', 'status', 'invitedBy', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['schoolId', 'schoolName', 'schoolOwnerId', 'email', 'emailLower', 'fullName', 'phone', 'inviteCode', 'permissions', 'status', 'invitedBy', 'acceptedByUid', 'authType', 'username', 'usernameLower', 'accessPassword', 'createdAt', 'updatedAt']) &&
                       isTimestampsCreate(incoming()) &&
                       isValidTeacherInvitation(incoming()) &&
                       isSchoolPrincipal(incoming().schoolId);

      allow update: if isSignedIn() &&
                       isValidId(inviteCode) &&
                       isValidTeacherInvitation(incoming()) &&
                       incoming().schoolId == existing().schoolId &&
                       incoming().inviteCode == existing().inviteCode &&
                       isTimestampsUpdate() && (
                         (isSchoolPrincipal(existing().schoolId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'permissions', 'schoolOwnerId', 'updatedAt'])) ||
                         (existing().status == 'pending' &&
                          !isStudentAccountLocked(request.auth.uid) &&
                          incoming().schoolOwnerId == existing().schoolOwnerId &&
                          incoming().status == 'accepted' &&
                          incoming().acceptedByUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedByUid', 'updatedAt']) &&
                          existsAfter(/databases/$(database)/documents/schools/$(existing().schoolId)/members/$(request.auth.uid)))
                       );

      allow delete: if isSignedIn() && isValidId(inviteCode) && isSchoolPrincipal(existing().schoolId);
    }

    match /teacher_credentials/{usernameLower} {
      allow get: if isSignedIn() && isValidId(usernameLower);
      allow list: if isSuperAdmin() || (isSignedIn() && (
        resource.data.schoolOwnerId == request.auth.uid ||
        isSchoolPrincipal(resource.data.schoolId)
      ));

      allow create: if isSignedIn() &&
                       isValidId(usernameLower) &&
                       incoming().usernameLower == usernameLower &&
                       incoming().status == 'pending' &&
                       incoming().invitedBy == request.auth.uid &&
                       incoming().schoolOwnerId == request.auth.uid &&
                       isSchoolPrincipal(incoming().schoolId) &&
                       incoming().keys().hasAll(['username', 'usernameLower', 'accessPassword', 'inviteCode', 'schoolId', 'schoolName', 'schoolOwnerId', 'status', 'invitedBy', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['username', 'usernameLower', 'accessPassword', 'inviteCode', 'schoolId', 'schoolName', 'schoolOwnerId', 'status', 'invitedBy', 'acceptedByUid', 'createdAt', 'updatedAt']) &&
                       isTimestampsCreate(incoming()) &&
                       isValidTeacherCredential(incoming()) &&
                       !exists(/databases/$(database)/documents/teacher_credentials/$(usernameLower));

      allow update: if isSignedIn() &&
                       isValidId(usernameLower) &&
                       isValidTeacherCredential(incoming()) &&
                       incoming().usernameLower == existing().usernameLower &&
                       incoming().inviteCode == existing().inviteCode &&
                       incoming().schoolId == existing().schoolId &&
                       isTimestampsUpdate() && (
                         (isSchoolPrincipal(existing().schoolId) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'accessPassword', 'schoolOwnerId', 'updatedAt'])) ||
                         (existing().status == 'pending' &&
                          !isStudentAccountLocked(request.auth.uid) &&
                          incoming().schoolOwnerId == existing().schoolOwnerId &&
                          incoming().status == 'accepted' &&
                          incoming().acceptedByUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedByUid', 'updatedAt']) &&
                          existsAfter(/databases/$(database)/documents/schools/$(existing().schoolId)/members/$(request.auth.uid)))
                       );

      allow delete: if isSignedIn() && isValidId(usernameLower) && isSchoolPrincipal(existing().schoolId);
    }

    // CollectionGroup rules for users querying their own memberships or requests across schools
    match /{path=**}/members/{memberUid} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/student_requests/{requestId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/teacher_requests/{requestId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- SCHOOLS & SCHOOL-SCOPED SUBCOLLECTIONS ---

    match /schools/{schoolId} {
      allow get: if isSuperAdmin() || (isSignedIn() && isValidId(schoolId) && (
        isSchoolStaff(schoolId) ||
        isSchoolMember(schoolId) ||
        (resource != null && existing().ownerId == request.auth.uid) ||
        (resource != null && (!('isPublic' in existing()) || existing().isPublic == true))
      ));
      allow list: if isSuperAdmin() || (isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.staffUids ||
        (request.auth.uid in resource.data.memberUids && (!('isPublic' in resource.data) || resource.data.isPublic == true))
      ));

      allow create: if isSignedIn() &&
                       isValidId(schoolId) &&
                       !isStudentAccountLocked(request.auth.uid) &&
                       incoming().ownerId == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       request.auth.uid in incoming().staffUids &&
                       incoming().keys().hasAll(['schoolCode', 'ownerId', 'name', 'schoolType', 'address', 'city', 'contactNumber', 'email', 'description', 'galleryUrls', 'timezone', 'memberUids', 'staffUids', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['schoolCode', 'ownerId', 'name', 'schoolType', 'address', 'city', 'contactNumber', 'email', 'description', 'establishedYear', 'website', 'logoUrl', 'bannerUrl', 'galleryUrls', 'timezone', 'memberUids', 'staffUids', 'isPublic', 'sessionIds', 'classIds', 'sectionIds', 'lastAcceptedPrincipalInviteCode', 'createdAt', 'updatedAt']) &&
                       isTimestampsCreate(incoming()) &&
                       isValidSchool(incoming()) &&
                       !exists(/databases/$(database)/documents/principal_locks/$(request.auth.uid)) &&
                       existsAfter(/databases/$(database)/documents/principal_locks/$(request.auth.uid)) &&
                       existsAfter(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid));

      allow update: if isSignedIn() &&
                       isValidId(schoolId) &&
                       isValidSchool(incoming()) &&
                       incoming().schoolCode == existing().schoolCode &&
                       isTimestampsUpdate() && (
                         (existing().ownerId == request.auth.uid &&
                          incoming().ownerId == existing().ownerId &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'schoolType', 'address', 'city', 'contactNumber', 'email', 'description', 'establishedYear', 'website', 'logoUrl', 'bannerUrl', 'galleryUrls', 'memberUids', 'staffUids', 'isPublic', 'sessionIds', 'classIds', 'sectionIds', 'updatedAt'])) ||
                         (isSchoolTeacher(schoolId) &&
                          incoming().ownerId == existing().ownerId &&
                          request.auth.uid in incoming().memberUids &&
                          request.auth.uid in incoming().staffUids &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'schoolType', 'address', 'city', 'contactNumber', 'email', 'description', 'establishedYear', 'website', 'logoUrl', 'bannerUrl', 'galleryUrls', 'memberUids', 'staffUids', 'sessionIds', 'classIds', 'sectionIds', 'updatedAt'])) ||
                         (isSchoolTeacher(schoolId) &&
                          incoming().ownerId == existing().ownerId &&
                          !(request.auth.uid in incoming().memberUids) &&
                          !(request.auth.uid in incoming().staffUids) &&
                          existing().memberUids.hasAll(incoming().memberUids) &&
                          existing().staffUids.hasAll(incoming().staffUids) &&
                          (incoming().memberUids.size() == existing().memberUids.size() - 1 ||
                           (!(request.auth.uid in existing().memberUids) && incoming().memberUids.size() == existing().memberUids.size())) &&
                          (incoming().staffUids.size() == existing().staffUids.size() - 1 ||
                           (!(request.auth.uid in existing().staffUids) && incoming().staffUids.size() == existing().staffUids.size())) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'staffUids', 'updatedAt'])) ||
                         (isSuperAdmin() &&
                          incoming().ownerId == existing().ownerId &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['isPublic', 'updatedAt'])) ||
                         (incoming().ownerId == request.auth.uid &&
                          !isStudentAccountLocked(request.auth.uid) &&
                          existing().ownerId != request.auth.uid &&
                          request.auth.uid in incoming().memberUids &&
                          request.auth.uid in incoming().staffUids &&
                          'lastAcceptedPrincipalInviteCode' in incoming() &&
                          incoming().lastAcceptedPrincipalInviteCode is string &&
                          exists(/databases/$(database)/documents/principal_invitations/$(incoming().lastAcceptedPrincipalInviteCode)) &&
                          get(/databases/$(database)/documents/principal_invitations/$(incoming().lastAcceptedPrincipalInviteCode)).data.schoolId == schoolId &&
                          get(/databases/$(database)/documents/principal_invitations/$(incoming().lastAcceptedPrincipalInviteCode)).data.status == 'pending' &&
                          getAfter(/databases/$(database)/documents/principal_invitations/$(incoming().lastAcceptedPrincipalInviteCode)).data.status == 'accepted' &&
                          getAfter(/databases/$(database)/documents/principal_invitations/$(incoming().lastAcceptedPrincipalInviteCode)).data.acceptedByUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['ownerId', 'lastAcceptedPrincipalInviteCode', 'memberUids', 'staffUids', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(schoolId) && existing().ownerId == request.auth.uid;

      // Memberships (RBAC source of truth)
      match /members/{memberUid} {
        allow get: if isSuperAdmin() || (isSignedIn() && isValidId(memberUid) && (request.auth.uid == memberUid || isSchoolStaff(schoolId)));
        allow list: if isSuperAdmin() || (isSignedIn() && (isSchoolPrincipal(schoolId) || resource.data.userId == request.auth.uid || resource.data.schoolOwnerId == request.auth.uid));

        allow create: if isSignedIn() &&
                         isValidId(memberUid) &&
                         incoming().schoolId == schoolId &&
                         incoming().userId == memberUid &&
                         incoming().keys().hasAll(['schoolId', 'schoolOwnerId', 'userId', 'role', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['schoolId', 'schoolOwnerId', 'userId', 'role', 'status', 'inviteCode', 'linkedStudentId', 'createdAt', 'updatedAt']) &&
                         isTimestampsCreate(incoming()) &&
                         isValidMember(incoming()) && (
                           (request.auth.uid == memberUid && incoming().role == 'principal' &&
                            !isStudentAccountLocked(request.auth.uid) &&
                            incoming().schoolOwnerId == request.auth.uid &&
                            getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.ownerId == request.auth.uid) ||
                           (request.auth.uid == memberUid && incoming().role == 'teacher' &&
                            !isStudentAccountLocked(request.auth.uid) &&
                            'inviteCode' in incoming() && incoming().inviteCode is string &&
                            exists(/databases/$(database)/documents/teacher_invitations/$(incoming().inviteCode)) &&
                            get(/databases/$(database)/documents/teacher_invitations/$(incoming().inviteCode)).data.status == 'pending' &&
                            get(/databases/$(database)/documents/teacher_invitations/$(incoming().inviteCode)).data.schoolId == schoolId &&
                            getAfter(/databases/$(database)/documents/teacher_invitations/$(incoming().inviteCode)).data.status == 'accepted') ||
                           (request.auth.uid == memberUid && incoming().role == 'student' &&
                            incoming().status == 'active' &&
                            exists(/databases/$(database)/documents/schools/$(schoolId)) &&
                            incoming().schoolOwnerId == schoolDoc(schoolId).data.ownerId &&
                            isSchoolVisibleToStudent(schoolId)) ||
                           (isSchoolPrincipal(schoolId) && (
                             incoming().role == 'student' ||
                             (incoming().role == 'teacher' && !isStudentAccountLocked(memberUid))
                           ))
                         );

        allow update: if isSignedIn() &&
                         isValidId(memberUid) &&
                         isValidMember(incoming()) &&
                         incoming().schoolId == existing().schoolId &&
                         incoming().userId == existing().userId &&
                         isTimestampsUpdate() && (
                           (isSchoolPrincipal(schoolId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'linkedStudentId', 'schoolOwnerId', 'updatedAt'])) ||
                           (request.auth.uid == memberUid &&
                            existing().role == 'student' &&
                            incoming().role == 'student' &&
                            incoming().status == 'active' &&
                            existing().status == 'active' &&
                            incoming().schoolOwnerId == existing().schoolOwnerId &&
                            isSchoolVisibleToStudent(schoolId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                           (request.auth.uid == memberUid &&
                            existing().role != 'student' &&
                            !isStudentAccountLocked(request.auth.uid) &&
                            incoming().role == 'teacher' &&
                            incoming().status == 'active' &&
                            'inviteCode' in incoming() && incoming().inviteCode is string &&
                            exists(/databases/$(database)/documents/teacher_invitations/$(incoming().inviteCode)) &&
                            get(/databases/$(database)/documents/teacher_invitations/$(incoming().inviteCode)).data.status == 'pending' &&
                            get(/databases/$(database)/documents/teacher_invitations/$(incoming().inviteCode)).data.schoolId == schoolId &&
                            getAfter(/databases/$(database)/documents/teacher_invitations/$(incoming().inviteCode)).data.status == 'accepted' &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['schoolOwnerId', 'role', 'status', 'inviteCode', 'updatedAt'])) ||
                           (request.auth.uid == memberUid &&
                            existing().role != 'student' &&
                            !isStudentAccountLocked(request.auth.uid) &&
                            incoming().role == 'principal' &&
                            incoming().status == 'active' &&
                            incoming().schoolOwnerId == request.auth.uid &&
                            getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.ownerId == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['schoolOwnerId', 'role', 'status', 'inviteCode', 'updatedAt']))
                         );

        allow delete: if isSignedIn() && isValidId(memberUid) && (
                          isSchoolPrincipal(schoolId) ||
                          (request.auth.uid == memberUid && existing().role in ['student', 'teacher'])
                        );
      }

      // Teacher Self-Service Join Requests
      match /teacher_requests/{requestId} {
        allow get: if isSuperAdmin() || (isSignedIn() && isValidId(requestId) && (request.auth.uid == requestId || isSchoolPrincipal(schoolId) || (resource != null && existing().userId == request.auth.uid)));
        allow list: if isSuperAdmin() || (isSignedIn() && (isSchoolPrincipal(schoolId) || resource.data.userId == request.auth.uid || resource.data.schoolOwnerId == request.auth.uid));

        allow create: if isSignedIn() &&
                         isValidId(requestId) &&
                         requestId == request.auth.uid &&
                         !isStudentAccountLocked(request.auth.uid) &&
                         incoming().userId == request.auth.uid &&
                         incoming().schoolId == schoolId &&
                         incoming().status == 'pending' &&
                         incoming().keys().hasAll(['schoolId', 'schoolOwnerId', 'schoolName', 'userId', 'fullName', 'email', 'phone', 'subjectSpecialty', 'note', 'status', 'staffUids', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['schoolId', 'schoolOwnerId', 'schoolName', 'userId', 'fullName', 'email', 'phone', 'subjectSpecialty', 'note', 'status', 'staffUids', 'createdAt', 'updatedAt']) &&
                         isTimestampsCreate(incoming()) &&
                         isValidTeacherRequest(incoming()) &&
                         exists(/databases/$(database)/documents/schools/$(schoolId));

        allow update: if isSignedIn() &&
                         isValidId(requestId) &&
                         isValidTeacherRequest(incoming()) &&
                         incoming().schoolId == existing().schoolId &&
                         incoming().userId == existing().userId &&
                         isTimestampsUpdate() && (
                           (isSchoolPrincipal(schoolId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'staffUids', 'schoolOwnerId', 'updatedAt'])) ||
                           (existing().userId == request.auth.uid && incoming().status == 'pending' &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'email', 'phone', 'subjectSpecialty', 'note', 'status', 'updatedAt']))
                         );

        allow delete: if isSignedIn() && isValidId(requestId) && (existing().userId == request.auth.uid || isSchoolPrincipal(schoolId));
      }

      // Teachers
      match /teachers/{teacherId} {
        allow get: if isSuperAdmin() || (isSignedIn() && isValidId(teacherId) && (request.auth.uid == teacherId || isSchoolMember(schoolId)));
        allow list: if isSuperAdmin() || (isSignedIn() && (
          isSchoolStaff(schoolId) ||
          isSchoolMember(schoolId) ||
          resource.data.schoolOwnerId == request.auth.uid ||
          request.auth.uid in resource.data.staffUids ||
          (isSchoolVisibleToStudent(schoolId) && ('memberUids' in resource.data) && request.auth.uid in resource.data.memberUids) ||
          resource.data.userId == request.auth.uid
        ));

        allow create: if isSignedIn() &&
                         isValidId(teacherId) &&
                         incoming().schoolId == schoolId &&
                         incoming().keys().hasAll(['schoolId', 'schoolOwnerId', 'userId', 'fullName', 'email', 'phone', 'joiningDate', 'isActive', 'permissions', 'staffUids', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['schoolId', 'schoolOwnerId', 'userId', 'fullName', 'email', 'phone', 'avatarUrl', 'joiningDate', 'isActive', 'permissions', 'staffUids', 'memberUids', 'createdAt', 'updatedAt']) &&
                         isTimestampsCreate(incoming()) &&
                         isValidTeacherProfile(incoming()) && (
                           isSchoolPrincipal(schoolId) ||
                           (request.auth.uid == teacherId && incoming().userId == request.auth.uid &&
                            !isStudentAccountLocked(request.auth.uid) &&
                            existsAfter(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)) &&
                            getAfter(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.role == 'teacher')
                         );

        allow update: if isSignedIn() &&
                         isValidId(teacherId) &&
                         isValidTeacherProfile(incoming()) &&
                         incoming().schoolId == existing().schoolId &&
                         incoming().userId == existing().userId &&
                         isTimestampsUpdate() && (
                           (isSchoolPrincipal(schoolId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'permissions', 'fullName', 'phone', 'schoolOwnerId', 'staffUids', 'memberUids', 'updatedAt'])) ||
                           (isSchoolTeacher(schoolId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['staffUids', 'memberUids', 'updatedAt'])) ||
                           (request.auth.uid == teacherId &&
                            incoming().userId == request.auth.uid &&
                            !isStudentAccountLocked(request.auth.uid) &&
                            existsAfter(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)) &&
                            getAfter(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.role == 'teacher' &&
                            getAfter(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.status == 'active' &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['schoolOwnerId', 'fullName', 'email', 'phone', 'joiningDate', 'isActive', 'permissions', 'staffUids', 'memberUids', 'updatedAt']))
                         );

        allow delete: if isSignedIn() && isValidId(teacherId) && (
                          isSchoolPrincipal(schoolId) ||
                          (request.auth.uid == teacherId && existing().userId == request.auth.uid)
                        );
      }

      // Teacher Assignments
      match /teacher_assignments/{assignmentId} {
        allow get: if isSuperAdmin() || (isSignedIn() && isValidId(assignmentId) && isSchoolMember(schoolId));
        allow list: if isSuperAdmin() || (isSignedIn() && (isSchoolStaff(schoolId) || isSchoolMember(schoolId) || resource.data.schoolOwnerId == request.auth.uid || request.auth.uid in resource.data.staffUids));

        allow create: if isSignedIn() &&
                         isValidId(assignmentId) &&
                         incoming().schoolId == schoolId &&
