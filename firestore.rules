                         incoming().schoolId == schoolId &&
                         incoming().keys().hasAll(['schoolId', 'schoolOwnerId', 'sessionId', 'sectionId', 'dayOfWeek', 'subject', 'startTime', 'endTime', 'teacherName', 'roomNumber', 'staffUids', 'memberUids', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['schoolId', 'schoolOwnerId', 'sessionId', 'sectionId', 'dayOfWeek', 'subject', 'startTime', 'endTime', 'teacherName', 'roomNumber', 'staffUids', 'memberUids', 'createdAt', 'updatedAt']) &&
                         isTimestampsCreate(incoming()) &&
                         isValidTimetableSlot(incoming()) &&
                         isSchoolStaff(schoolId);

        allow update: if isSignedIn() &&
                         isValidId(slotId) &&
                         isValidTimetableSlot(incoming()) &&
                         incoming().schoolId == existing().schoolId &&
                         isTimestampsUpdate() &&
                         isSchoolPrincipal(schoolId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['dayOfWeek', 'subject', 'startTime', 'endTime', 'teacherName', 'roomNumber', 'staffUids', 'memberUids', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(slotId) && isSchoolStaff(schoolId);
      }

      // Homework
      match /homework/{homeworkId} {
        allow get: if isSignedIn() && isValidId(homeworkId) && isSchoolMember(schoolId);
        allow list: if isSignedIn() && (resource.data.schoolOwnerId == request.auth.uid || request.auth.uid in resource.data.staffUids || request.auth.uid in resource.data.memberUids);

        allow create: if isSignedIn() &&
                         isValidId(homeworkId) &&
                         incoming().schoolId == schoolId &&
                         incoming().keys().hasAll(['schoolId', 'schoolOwnerId', 'sessionId', 'sectionId', 'subject', 'title', 'instructions', 'dueDate', 'teacherName', 'staffUids', 'memberUids', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['schoolId', 'schoolOwnerId', 'sessionId', 'sectionId', 'subject', 'title', 'instructions', 'dueDate', 'attachmentUrl', 'teacherId', 'teacherName', 'staffUids', 'memberUids', 'createdAt', 'updatedAt']) &&
                         isTimestampsCreate(incoming()) &&
                         isValidHomeworkItem(incoming()) &&
                         isSchoolStaff(schoolId);

        allow update: if isSignedIn() &&
                         isValidId(homeworkId) &&
                         isValidHomeworkItem(incoming()) &&
                         incoming().schoolId == existing().schoolId &&
                         isTimestampsUpdate() &&
                         (isSchoolPrincipal(schoolId) || existing().teacherId == request.auth.uid) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['subject', 'title', 'instructions', 'dueDate', 'attachmentUrl', 'staffUids', 'memberUids', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(homeworkId) && (isSchoolPrincipal(schoolId) || existing().teacherId == request.auth.uid);
      }

      // Notifications
      match /notifications/{notificationId} {
        allow get: if isSignedIn() && isValidId(notificationId) && existing().userId == request.auth.uid;
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.schoolOwnerId == request.auth.uid);

        allow create: if isSignedIn() &&
                         isValidId(notificationId) &&
                         incoming().schoolId == schoolId &&
                         incoming().keys().hasAll(['schoolId', 'schoolOwnerId', 'userId', 'title', 'message', 'category', 'isRead', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['schoolId', 'schoolOwnerId', 'userId', 'title', 'message', 'category', 'isRead', 'referenceId', 'createdAt', 'updatedAt']) &&
                         isTimestampsCreate(incoming()) &&
                         isValidNotification(incoming()) &&
                         isSchoolStaff(schoolId);

        allow update: if isSignedIn() &&
                         isValidId(notificationId) &&
                         isValidNotification(incoming()) &&
                         existing().userId == request.auth.uid &&
                         incoming().userId == existing().userId &&
                         incoming().schoolId == existing().schoolId &&
                         isTimestampsUpdate() &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(notificationId) && (existing().userId == request.auth.uid || isSchoolPrincipal(schoolId));
      }
    }
  }
}
